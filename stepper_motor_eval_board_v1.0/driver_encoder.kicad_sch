	(text "ELECTRICAL CHARACTERISTICS:\nDriver current depending on motor: 1A/phase with 2ohm phase resistance\nPmotor_coil = (1A)² x (2ohm) = 2W\nMotor has two coils so : 2W x 2 = 4W per motor\nIdriver = P/U = 4W / 24V = 0.167A\nTwo drivers in total so : 0.167A x 2 = 0.33A\n\nTwo drivers = 24V 0.5A\n\nOne driver IO = 3V3 30µA\nTwo driver IO = 3V3 60µA"
		(exclude_from_sim no)
		(at 23.114 32.766 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "c49e2775-21ad-4d59-a2b3-b8d7c129a044")
	)
	(text "ELECTRICAL CHARACTERISTICS:\n1 Encoder : \n5V 50mA estimated, to be measured\n2 Encoders : \n5V 50mA x 2 = 100mA"
